{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pyocd-gdbserver",
            "detail": "启动 pyOCD gdbserver（端口 3333）并等到端口就绪，供 Cortex-Debug 以 external 方式连接",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/start-gdbserver.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
